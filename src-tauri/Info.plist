<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>Request microphone access to transcribe audio locally</string>
  <!-- DanyWhere: shown when the user allows reading window titles without
       Accessibility (src/window_capture.rs). -->
  <key>NSAppleEventsUsageDescription</key>
  <string>DanyWhere reads the title of the window you dictate into, so that post-processing can use your earlier dictations from the same window. It reads nothing else.</string>
  <!-- DanyWhere: "Insert Last Dictation" (src/insert_service.rs). It takes
       nothing and returns text, which the calling app inserts itself. The
       test builds' build script renames the menu item and port per variant. -->
  <key>NSServices</key>
  <array>
    <dict>
      <key>NSMenuItem</key>
      <dict>
        <key>default</key>
        <string>DanyWhere: Insert Last Dictation</string>
      </dict>
      <key>NSMessage</key>
      <string>insertLastDictation</string>
      <key>NSPortName</key>
      <string>DanyWhere</string>
      <key>NSReturnTypes</key>
      <array>
        <string>NSStringPboardType</string>
        <string>public.utf8-plain-text</string>
      </array>
      <!-- Present (even empty) so macOS enables the service by default. -->
      <key>NSRequiredContext</key>
      <dict/>
      <!-- Milliseconds the calling app waits. A call during a dictation ends
           the recording and answers once the text is ready; DanyWhere gives
           up after 20 s (WAIT_FOR_DICTATION), well within this. -->
      <key>NSTimeout</key>
      <string>30000</string>
    </dict>
    <!-- The dictation shortcut's own service: DanyWhere gives it the dictation
         shortcut and releases that shortcut during a recording, so its second
         press ends the dictation and inserts it (src/dictation_key_inserts.rs). -->
    <dict>
      <key>NSMenuItem</key>
      <dict>
        <key>default</key>
        <string>DanyWhere: End Dictation and Insert</string>
      </dict>
      <key>NSMessage</key>
      <string>endDictationAndInsert</string>
      <key>NSPortName</key>
      <string>DanyWhere</string>
      <key>NSReturnTypes</key>
      <array>
        <string>NSStringPboardType</string>
        <string>public.utf8-plain-text</string>
      </array>
      <key>NSRequiredContext</key>
      <dict/>
      <key>NSTimeout</key>
      <string>30000</string>
    </dict>
    <!-- The same for the post-process shortcut: ends the dictation with
         post-processing. -->
    <dict>
      <key>NSMenuItem</key>
      <dict>
        <key>default</key>
        <string>DanyWhere: End Dictation with Post-processing and Insert</string>
      </dict>
      <key>NSMessage</key>
      <string>endDictationWithPostProcessAndInsert</string>
      <key>NSPortName</key>
      <string>DanyWhere</string>
      <key>NSReturnTypes</key>
      <array>
        <string>NSStringPboardType</string>
        <string>public.utf8-plain-text</string>
      </array>
      <key>NSRequiredContext</key>
      <dict/>
      <key>NSTimeout</key>
      <string>30000</string>
    </dict>
  </array>
</dict>
</plist>
