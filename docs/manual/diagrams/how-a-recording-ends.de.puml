!$endKey = "Diese Endtaste\nbeendet sie"
!$aStartAgain = "eine Starttaste,\nerneut angetippt"
!$startAgain = "Die Endtaste mit\nderselben Tasten-\nkombination beendet\nsie, falls es eine gibt"
!$aReleased = "eine gehaltene\nStarttaste,\nlosgelassen"
