@startuml
' The Defaults and two profiles as layers, in English. The structure is in
' defaults-and-profiles.iuml (a Graphviz graph); UI terms as in
' src/i18n/locales/en/translation.json. The texts go into an HTML label:
' write & as &amp; and < as &lt;, and break a line with $br.
!include graphviz.iuml
' The columns: the post-processing switch, the end shortcuts, the rest.
!$hPost = "Post Processing"
!$hEnd = "End Shortcuts"
!$hRest = "All the rest"
' The rows.
!$chat = "Chat"
!$terminal = "Terminal"
!$profile = "Profile"
!$defaults = "Defaults"
!$defaultsKind = "every value"
' What a profile page says under a value and next to a list entry.
!$tDefault = "Default"
!$tOwnValue = "Own value"
!$tOwn = "own"
!$tAdded = "own, new"
!$tOff = "off"
' Values: the switch, and end shortcuts a new Mac installation brings,
' plus one of the profile's own.
!$on = "on"
!$off = "off"
!$space = "Direct · Space"
!$enter = "Direct · Send Enter"
!$paragraph = "Direct · Paragraph"
!$reply = "Reply"
!$restList = "Speech Model," + $br + "Microphone," + $br + "Paste Method, …"
!$caption = "A profile builds on the Defaults: its own values count, everything" + $br + "else comes from the Defaults. Profiles take nothing from each other."
' Outside the layers.
!$appTitle = "Application Settings"
!$appList = "Application Language · Launch on Startup · Check for Updates · …"
!$appNote = "In no profile: the same for every dictation."
!include defaults-and-profiles.iuml
@enduml
