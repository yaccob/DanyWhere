@startuml
' How a recording ends, in English. The structure is in
' how-a-recording-ends.iuml; UI terms as in
' src/i18n/locales/en/translation.json.
' "\n" breaks a line; no ";" in a text (it would end a step).
!$yes = "yes"
!$no = "no"
!$runs = "A recording runs"
!$noteCopy = "“Copy Last Transcript” ends it\ntoo, as its start shortcut would,\nand puts the text on the\nclipboard instead"
!$noteLinux = "On Linux, no end shortcut's\nown combination is taken,\nthere are no instruction\nshortcuts, and Esc doesn't cancel"
!$qWhat = "What ends it?"
!$aEndKey = "an end\nshortcut,\ntapped"
!$endKey = "That end\nshortcut\nends it"
!$aStartAgain = "a start or\nhold shortcut,\ntapped"
!$startAgain = "The end\nshortcut with\nthe same\ncombination\nends it, if\nthere is one"
!$aReleased = "a hold\nshortcut,\nreleased"
!$held = "That hold\nshortcut's\nvalues\nend it"
!$noteShort = "Released at once,\na hold shortcut that\nisn't also a start\nshortcut discards\nthe recording"
!$aInstruction = "an instruction\nshortcut"
!$instruction = "“Instruction”:\nwhat you say now\ntells post-processing\nwhat to do"
!$qInstrHow = "Tapped\nor held?"
!$aTapped = "tapped"
!$aHeld = "held"
!$instrTapped = "An end\nshortcut\nends it"
!$instrHeld = "Releasing it\nends it with its\nown values"
!$aCancel = "“Cancel\nShortcut”\n(Esc)"
!$cancelled = "Cancelled:\nnothing is\ntranscribed\nor kept"
!$qPost = "An instruction shortcut pressed,\nor “Post Processing” set\nto “Always”?"
!$post = "Post-processed with the profile's\nactive prompts and the spoken\ninstruction, if there is one"
!$qContext = "“Send Context” on\nfor this end?"
!$context = "Earlier dictations from the\nsame window go along"
!$notPost = "Not post-processed,\nno context"
!$append = "“Append”: its text is added, then\nits key press, which is sent\nonly when the text is pasted"
!include style.iuml
!include how-a-recording-ends.iuml
@enduml
