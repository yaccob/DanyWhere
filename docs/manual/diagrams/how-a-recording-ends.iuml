' How a recording ends: the structure. The texts come from
' how-a-recording-ends.<lang>.puml, which includes this file after
' style.iuml. Facts checked against the code; see the comments for where.

start
' "Copy Last Transcript" during a recording: coordinator.finish_recording
' ends it as its start shortcut would (EndChoice::Start), and the text
' goes on the clipboard (dictation_key_inserts.rs, copy_last_transcript).
' Linux: no combination taken only while recording, so no end shortcut's
' own one, no instruction shortcuts and no cancel shortcut
' (shortcut/profile_sync.rs; instruction_keys::taken;
' shortcut/mod.rs, reconcile_cancel_shortcut).
:$runs;
note left: $noteCopy
note right: $noteLinux
' transcription_coordinator.rs, CoordinatorState::on_input: the roles of
' a press resolved from the lists of the profile that applies now.
switch ($qWhat)
case ($aEndKey)
  ' Registered only while recording (end_keys.rs, resolve).
  :$endKey;
case ($aStartAgain)
  ' A start or hold shortcut's press during a recording is a press of the
  ' end with its combination, else nothing (EndChoice::Key via keys_end).
  :$startAgain;
case ($aReleased)
  ' The release after the threshold ends with the hold shortcut's values
  ' (EndChoice::Held); a short press of a hold-only shortcut discards the
  ' recording (Effect::Discard).
  :$held;
  note right: $noteShort
case ($aInstruction)
  ' The stage "Recording: instruction" (dictation_flow::instruction):
  ' tapped, an end shortcut sends; held, the release sends with the
  ' instruction shortcut's values (instruction_keys::instruction_end).
  :$instruction;
  if ($qInstrHow) then ($aTapped)
    :$instrTapped;
  else ($aHeld)
    :$instrHeld;
  endif
case ($aCancel)
  :$cancelled; <<stop>>
  stop
endswitch
' Post-processed when an instruction shortcut was pressed or the profile's
' mode is "always" (settings::PostProcessMode::post_processes; with
' "never" no instruction shortcut is taken); context only then and when
' the end's "Send Context" is on (dictation_snapshot.rs, build).
if ($qPost) then ($yes)
  :$post;
  if ($qContext) then ($yes)
    :$context;
  else ($no)
  endif
else ($no)
  :$notPost; <<quiet>>
endif
' The text of "Append" goes with every delivery; its key press only
' after a paste (append_text.rs; clipboard.rs).
:$append;
stop
