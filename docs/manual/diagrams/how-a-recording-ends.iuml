' How a recording ends: the structure. The texts come from
' how-a-recording-ends.<lang>.puml, which includes this file after
' style.iuml. Facts checked against the code; see the comments for where.

start
' "Copy Last Transcript" during a recording: coordinator.finish_recording
' ends it as its start shortcut would (EndChoice::Start), and the text
' goes on the clipboard (dictation_key_inserts.rs, copy_last_transcript).
' Linux: no end shortcut's own combination and no cancel shortcut while
' recording (shortcut/profile_sync.rs, END_KEYS_WHILE_RECORDING;
' shortcut/mod.rs, reconcile_cancel_shortcut).
:$runs;
note left: $noteCopy
note right: $noteLinux
' transcription_coordinator.rs, CoordinatorState::on_input and
' on_end_key; end_keys.rs, resolve.
switch ($qWhat)
case ($aEndKey)
  ' Registered only while recording; ends it held or locked (on_end_key).
  :$endKey;
case ($aStartAgain)
  ' A start shortcut's press during a recording, its own or the other,
  ' is a press of the end with its combination, else nothing
  ' (EndChoice::Key via keys_end).
  :$startAgain;
case ($aReleased)
  ' Push-to-talk: every release; hold-or-toggle: a hold of at least
  ' hold_threshold_ms (300 ms); toggle: never (finish_hold).
  :$held;
case ($aCancel)
  :$cancelled; <<stop>>
  stop
endswitch
' post_process = end.post_process && the profile's post_process_enabled
' (app_profiles::effective_post_process); with_context = post_process &&
' end.send_context (dictation_snapshot.rs, build).
if ($qPost) then ($yes)
  :$post;
  if ($qContext) then ($yes)
    :$context;
  else ($no)
  endif
else ($no)
  :$notPost; <<quiet>>
endif
' The text of "Append" goes with every delivery; its key press only
' after a paste (append_text.rs; clipboard.rs).
:$append;
stop
