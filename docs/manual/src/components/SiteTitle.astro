---
// Starlight's site title with the app's wordmark and, next to it, the word
// "Manual" in the page's language. The full title stays for screen readers.
import { logos } from "virtual:starlight/user-images";
import config from "virtual:starlight/user-config";

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
const label = Astro.locals.t("dw.siteTitle.label");
const logo = config.logo && !("src" in config.logo) ? config.logo : undefined;
---

<a href={siteTitleHref} class="site-title sl-flex">
  {
    logo && logos.dark && logos.light && (
      <>
        <img
          class="light:sl-hidden print:hidden"
          alt=""
          src={logos.dark.src}
          width={logos.dark.width}
          height={logos.dark.height}
        />
        <img
          class="dark:sl-hidden print:block"
          alt=""
          src={logos.light.src}
          width={logos.light.width}
          height={logos.light.height}
        />
      </>
    )
  }
  <span class="dw-site-label" aria-hidden="true">{label}</span>
  <span class="sr-only" translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: 0.7rem;
    color: var(--sl-color-text-accent);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
  img {
    height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y) - 0.25rem);
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: 0 50%;
  }
  .dw-site-label {
    padding-left: 0.7rem;
    border-left: 1px solid var(--sl-color-hairline-light);
    color: var(--sl-color-gray-2);
    font-family: var(--dw-font-display);
    font-size: var(--sl-text-xl);
    font-weight: 600;
    line-height: 1.2;
    overflow: hidden;
  }
</style>
